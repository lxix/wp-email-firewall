#!/usr/bin/env bash
# WP-CLI inside the test environment, e.g.: test-env/wp plugin list
set -euo pipefail

cd "$(dirname "$0")"

# PHP's default 128M is too little for WP-CLI to load WooCommerce together with a few more plugins.
exec docker compose --progress quiet run --rm -T cli php -d memory_limit=512M /usr/local/bin/wp "$@"
